<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
 -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Auth tokens must never leave the device. -->
        <exclude domain="sharedpref" path="auth_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_session.xml"/>
    </device-transfer>
</data-extraction-rules>
